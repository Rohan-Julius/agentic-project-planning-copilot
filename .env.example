# Copy to .env for local dev. Dev uses native Ollama + local Qdrant; the demo
# swaps these values for the Dockerized services — code never changes (spec §15).

# --- Local LLM runtime (Ollama) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct
# Optional explicit quantization tag; leave blank to use the model default (spec §15).
LLM_QUANTIZATION=

# --- Embeddings (Sentence Transformers, local) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_PROJECT_COLLECTION=project_knowledge
QDRANT_ORG_COLLECTION=organizational_knowledge

# --- Storage ---
DATA_DIR=./data
SQLITE_URL=sqlite:///./data/app.db

# --- Frontend (CORS) ---
# Comma-separated origins allowed to call this API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
