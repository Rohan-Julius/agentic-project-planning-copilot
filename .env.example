# Copy to .env for local dev. Dev uses native Ollama + local Qdrant; the demo
# swaps these values for the Dockerized services — code never changes (spec §15).

# --- Local LLM runtime (Ollama) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct
# Optional explicit quantization tag; leave blank to use the model default (spec §15).
LLM_QUANTIZATION=

# --- Embeddings (Sentence Transformers, local) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# set to "mps"/"cuda" if your deployment has a GPU Ollama isn't already using.
EMBEDDING_DEVICE=cpu

# --- Chunking (spec §6.3) ---
CHUNK_TOKEN_LIMIT=512
CHUNK_OVERLAP_RATIO=0.15

# --- Vector store (Qdrant) ---
# Leave blank (default) to use an embedded, file-backed Qdrant store under
# DATA_DIR/qdrant_local — no server process or Docker required. Set to a URL
# (e.g. http://localhost:6333) to use a running Qdrant server instead, as the
# docker-compose.yml demo topology does.
QDRANT_URL=
QDRANT_PROJECT_COLLECTION=project_knowledge
QDRANT_ORG_COLLECTION=organizational_knowledge

# --- Storage ---
DATA_DIR=./data
SQLITE_URL=sqlite:///./data/app.db

# --- Frontend (CORS) ---
# Comma-separated origins allowed to call this API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
